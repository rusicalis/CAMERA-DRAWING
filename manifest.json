      shapeMarkup=`<path d="${cadScreen.d}" fill="none" stroke="#111" stroke-width="${wirePx.toFixed(1)}" stroke-linecap="round" stroke-linejoin="round"/><path d="${cadScreen.d}" fill="none" stroke="#d1d5db" stroke-width="1.6" stroke-dasharray="6 4" opacity="0.95"/>${photoInset}`;
