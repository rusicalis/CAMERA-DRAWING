    const stepY=Math.max(1,Math.floor(h/360)),stepX=Math.max(1,Math.floor(w/360));
    for(let x=0;x<w;x++){
      let s=0,n=0;for(let y=0;y<h;y+=stepY){s+=255-gray[y*w+x];n++;}
      const ph=x%p;sx[ph]+=s/Math.max(1,n);cx[ph]++;
